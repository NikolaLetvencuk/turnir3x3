# Kopiraj ovaj fajl u .env.local i popuni vrednosti za KONKRETAN turnir.
# (.env.local se NE commit-uje — drži tajne van git-a.)

# Supabase projekat OVOG turnira (svaki turnir = svoj Supabase projekat)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # Settings → API → anon public
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # Settings → API → service_role (TAJNO)

# Email naloga koji je admin ovog turnira (mora da se registruje na sajtu)
ADMIN_EMAIL=admin@primer.com

# Demo branding picker (main demo site only; leave unset in customer clones)
NEXT_PUBLIC_DEMO_MODE=true
